{
  "name": "serverless-jwt-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "check": "vp check && vp run -r typecheck:lib && jsdoc-lint && tsc -p scripts/release.tsconfig.json",
    "lint:fix": "vp check --fix",
    "lint:jsdoc": "jsdoc-lint",
    "prepare": "vp config",
    "ready": "pnpm check && vp test run",
    "test": "vp test run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:tooling-security": "node scripts/tooling-security.mjs",
    "test:e2e": "vp test run --config e2e/vite.config.ts --project pr",
    "test:e2e:nightly": "E2E_DOCKER=1 vp test run --config e2e/vite.config.ts --project nightly",
    "api:report": "node scripts/api-report.mjs",
    "version:set": "node scripts/set-version.ts",
    "pack:public": "node scripts/pack-public.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "test:coverage": "vp test run --project @serverless-jwt/jwt-verifier --coverage && node scripts/coverage-check.mjs",
    "test:mutation": "stryker run",
    "test:runtime": "node scripts/runtime-check.mjs",
    "test:benchmark": "vp test bench --run --config scripts/benchmark.config.mjs",
    "test:properties:nightly": "NIGHTLY=1 vp test run --project @serverless-jwt/jwt-verifier",
    "size": "node scripts/size.mjs",
    "api:check": "node scripts/api-report.mjs --check",
    "test:peers": "node scripts/peers.mjs",
    "test:adapter-bundle": "node scripts/adapter-bundle.mjs",
    "test:conformance:workerd": "vp test run --config packages/cloudflare/workerd.config.mjs",
    "test:coverage:integrations": "vp test run --config scripts/integration-coverage.config.mjs --coverage",
    "conformance:check": "node scripts/conformance-check.mjs",
    "build:apps": "vp run -r build:app",
    "test:e2e:release": "node scripts/e2e-release.mjs",
    "test:e2e:runtimes": "E2E_INTEGRATION=hono vp test run --config e2e/vite.config.ts --project pr",
    "build:e2e": "node scripts/e2e-build.mjs",
    "test:release": "tsc -p scripts/release.tsconfig.json && vp test run scripts/release.test.mjs scripts/package-validation.test.mjs",
    "test:release:drill": "node scripts/release-drill.ts",
    "docs:reference": "node scripts/docs-reference.mjs",
    "release:diff": "node scripts/release-diff.mjs",
    "docs:examples": "node scripts/docs-examples.mjs",
    "docs:links": "node scripts/docs-links.mjs",
    "docs:packages": "node scripts/docs-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/vitest-runner": "catalog:",
    "@stylistic/eslint-plugin": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fast-check": "catalog:",
    "jsdoc-lint": "catalog:",
    "npm": "catalog:",
    "publint": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "yaml": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.17.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
