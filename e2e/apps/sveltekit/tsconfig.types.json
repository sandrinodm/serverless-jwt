{
  "extends": ["$app/tsconfig", "../../../tsconfig.base.json"],
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": false,
    "noEmit": true,
    "isolatedDeclarations": true,
    "declaration": true,
    "types": ["node", "$app/types"],
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "lib": ["ES2025", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "isolatedModules": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src/**/*.ts", ".svelte-kit/types/**/*.d.ts"]
}
