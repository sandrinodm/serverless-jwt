{
  "name": "@serverless-jwt/jwt-verifier",
  "version": "0.0.0",
  "description": "Portable access-token verification.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/serverless-jwt.git",
    "directory": "packages/jwt-verifier"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./adapter": {
      "source": "./src/adapter.ts",
      "default": "./dist/adapter.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./adapter": "./dist/adapter.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "typecheck:lib": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "jose": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
