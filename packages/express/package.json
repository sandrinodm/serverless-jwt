{
  "name": "@serverless-jwt/express",
  "version": "0.0.0",
  "description": "Bearer access-token integration for express.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/serverless-jwt.git",
    "directory": "packages/express"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "typecheck:lib": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@serverless-jwt/jwt-verifier": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "catalog:",
    "express": "catalog:"
  },
  "peerDependencies": {
    "@types/express": "^5",
    "@types/node": "^24 || ^26",
    "express": "^5"
  },
  "peerDependenciesMeta": {
    "@types/node": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
