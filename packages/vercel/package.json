{
  "name": "@serverless-jwt/vercel",
  "version": "0.0.0",
  "description": "Bearer access-token authentication for Vercel Web Functions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/serverless-jwt.git",
    "directory": "packages/vercel"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "typecheck:lib": "tsc -p tsconfig.lib.json"
  },
  "dependencies": {
    "@serverless-jwt/jwt-verifier": "workspace:*"
  },
  "devDependencies": {
    "@vercel/functions": "catalog:"
  },
  "peerDependencies": {
    "@vercel/functions": "3.10.6"
  },
  "peerDependenciesMeta": {
    "@vercel/functions": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
